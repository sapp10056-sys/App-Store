rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Applications collection for NovaStore public catalog
    match /applications/{appId} {
      // Anyone can read and publish apps so catalog is visible to all users across devices
      allow read, write: if true;
    }

    // Developer accounts for publishing and updating APKs
    match /developers/{devId} {
      allow read, write: if true;
    }

    match /developerAccounts/{devId} {
      allow read, write: if true;
    }

    // User reports on applications
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Remote app store configuration
    match /appConfiguration/{configId} {
      allow read, write: if true;
    }

    // Allow read and write on all collections so every user sees uploaded APKs immediately
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
