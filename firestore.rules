rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Applications collection for NovaStore public catalog
    match /applications/{appId} {
      // Anyone can read apps so catalog is visible to all users across devices
      allow read: if true;

      // Anyone can publish an app
      allow create: if true;

      // Anyone can update app (e.g., download count increment, version update)
      allow update: if true;

      // Allow delete for admin / removal
      allow delete: if true;
    }

    // User reports on applications
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Remote app store configuration
    match /appConfiguration/{configId} {
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
